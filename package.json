{
  "name": "yamlresume",
  "version": "1.0.0",
  "description": "YAMLResume project for Shane Martin",
  "scripts": {
    "build:tex": "yamlresume build --no-pdf resume.yml",
    "build:pdf": "xelatex resume.tex",
    "build": "npm run build:tex && npm run build:pdf",
    "dev": "yamlresume dev resume.yml",
    "validate": "yamlresume validate resume.yml",
    "yamlresume": "yamlresume",
    "prepare": "husky",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "YAMLResume",
    "Resume",
    "CV"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yamlresume": "latest"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "sort-package-json": "^3.6.0"
  },
  "volta": {
    "node": "25.2.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
